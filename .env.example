# Copier ce fichier vers .env sur o2switch, puis remplir les valeurs cPanel.
# Ne jamais committer le vrai .env.

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=cpaneluser_bininga
MYSQL_USER=cpaneluser_bininga
MYSQL_PASSWORD=mot_de_passe_mysql

# Admin
BININGA_USER=admin
BININGA_PASS=mot_de_passe_admin_fort
ADMIN_SECRET_PATH=espace-prive-bininga-long-secret
BININGA_PRODUCTION=1

# URL publique utilisée dans les liens de réinitialisation de mot de passe.
# Exemple futur : https://bininga-officiel.com
AUTH_PUBLIC_BASE_URL=https://votre-domaine-public.example

# Email de sécurité — Resend recommandé si disponible.
# Le même RESEND_API_KEY peut être utilisé par d'autres projets uniquement si
# vous décidez explicitement de le configurer aussi sur ce déploiement.
RESEND_API_KEY=
AUTH_EMAIL_FROM=BININGA <securite@votre-domaine.example>

# Alternative SMTP (le système utilise ces valeurs si Resend n'est pas configuré).
AUTH_SMTP_HOST=smtp.gmail.com
AUTH_SMTP_PORT=465
AUTH_SMTP_USER=
AUTH_SMTP_PASS=

# Compatibilité avec les notifications email déjà existantes :
NOTIF_EMAIL_FROM=
NOTIF_EMAIL_PASS=
NOTIF_EMAIL_TO=

# Optionnel : seulement pour restaurer volontairement data.json vers la base.
# Laisser vide ou 0 en production.
BININGA_FORCE_FILE_SYNC=0

# Optionnel mais recommandé en production réelle :
# si cette variable vaut 1, le site refuse de démarrer sans MySQL/PostgreSQL.
# BININGA_REQUIRE_DB=1
